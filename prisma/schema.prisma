generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailProvider {
  GMAIL
  OUTLOOK
  IMAP
  MOCK
}

enum ApplicationStatus {
  APPLIED
  APPLICATION_RECEIVED
  UNDER_REVIEW
  RECRUITER_CALL
  INTERVIEW_SCHEDULED
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  ASSESSMENT_TEST
  OFFER
  REJECTED
  WITHDRAWN
  NEEDS_REVIEW
}

enum ScanStatus {
  RUNNING
  SUCCESS
  FAILED
}

model User {
  id             String                  @id @default(cuid())
  email          String                  @unique
  name           String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  accounts       ConnectedEmailAccount[]
  applications   JobApplication[]
  scanLogs       ScanLog[]
}

model ConnectedEmailAccount {
  id                    String              @id @default(cuid())
  userId                String
  provider              EmailProvider
  email                 String
  displayName           String?
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  providerAccountId     String?
  syncEnabled           Boolean             @default(true)
  lastScanAt            DateTime?
  lastHistoryToken      String?
  lastDeltaLink         String?
  lastScanEmails        Int                 @default(0)
  lastScanNewApps       Int                 @default(0)
  lastScanUpdates       Int                 @default(0)
  lastScanErrors        Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages              EmailMessage[]
  applications          JobApplication[]
  updates               ApplicationUpdate[]
  scanLogs              ScanLog[]

  @@unique([userId, provider, email])
  @@index([userId])
}

model EmailMessage {
  id                    String                  @id @default(cuid())
  userId                String
  accountId             String
  providerMessageId     String
  providerThreadId      String?
  internetMessageId     String?
  folder                String?
  subject               String
  senderEmail           String
  senderName            String?
  recipientEmails       String[]
  receivedAt            DateTime
  sentAt                DateTime?
  snippet               String?
  bodyText              String?
  originalUrl           String?
  isJobRelated          Boolean                 @default(false)
  classifierConfidence  Float                   @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  account               ConnectedEmailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  applicationUpdates    ApplicationUpdate[]

  @@unique([accountId, providerMessageId])
  @@index([userId, receivedAt])
  @@index([providerThreadId])
}

model JobApplication {
  id               String              @id @default(cuid())
  userId           String
  accountId        String?
  company          String
  normalizedCompany String
  position         String
  normalizedPosition String
  status           ApplicationStatus
  rejectionReason  String?
  interviewDate    DateTime?
  interviewType    String?
  meetingLink      String?
  contactPerson    String?
  recruiterEmail   String?
  senderEmail      String?
  source           String?
  appliedDate      DateTime?
  lastEmailDate    DateTime?
  notes            String?
  originalSubject  String?
  originalUrl      String?
  providerThreadId String?
  needsReview      Boolean             @default(false)
  confidence       Float               @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account          ConnectedEmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  updates          ApplicationUpdate[]

  @@unique([userId, normalizedCompany, normalizedPosition, providerThreadId])
  @@index([userId, status])
  @@index([userId, updatedAt])
}

model ApplicationUpdate {
  id              String                 @id @default(cuid())
  applicationId   String
  emailMessageId  String?
  accountId       String?
  status          ApplicationStatus
  summary         String
  rejectionReason String?
  interviewDate   DateTime?
  interviewType   String?
  meetingLink     String?
  contactPerson   String?
  confidence      Float                  @default(0)
  createdAt       DateTime               @default(now())
  application     JobApplication         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  emailMessage    EmailMessage?          @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)
  account         ConnectedEmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

model ScanLog {
  id                String                 @id @default(cuid())
  userId            String
  accountId         String?
  status            ScanStatus
  startedAt         DateTime               @default(now())
  finishedAt        DateTime?
  emailsScanned     Int                    @default(0)
  newApplications   Int                    @default(0)
  updatesFound      Int                    @default(0)
  errors            Int                    @default(0)
  message           String?
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           ConnectedEmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
}
